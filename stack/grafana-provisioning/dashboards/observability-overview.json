{
  "title": "Smoke Test - smoke-test-service",
  "description": "KPIs, throughput/latency, logs, and traces for the OpenTelemetry package smoke test (test.ts).",
  "uid": "smoke-test-service-overview",
  "tags": ["opentelemetry", "smoke-test", "mimir", "loki", "tempo"],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    { "id": 1, "type": "row", "title": "Core Service KPIs", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },

    {
      "id": 2,
      "type": "stat",
      "title": "Total Request Volume",
      "description": "Total simulated requests over the selected time range (Mimir).",
      "datasource": "Mimir",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Mimir",
          "expr": "sum(increase(http_requests_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate Percentage",
      "description": "Share of requests that returned a 500 (http.status_code) vs total, over the selected range (Mimir).",
      "datasource": "Mimir",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Mimir",
          "expr": "100 * sum(increase(http_requests_total{http_status_code=\"500\"}[$__range])) / sum(increase(http_requests_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "95th Percentile Latency",
      "description": "p95 request duration over the last 5m, from http_request_duration_seconds_bucket (Mimir).",
      "datasource": "Mimir",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Mimir",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.08 }
            ]
          }
        },
        "overrides": []
      }
    },

    { "id": 5, "type": "row", "title": "Performance Over Time", "collapsed": false, "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 }, "panels": [] },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Throughput (req/s by status code)",
      "description": "Requests per second, split by http_status_code (200 vs 500).",
      "datasource": "Mimir",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Mimir",
          "expr": "sum by (http_status_code) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "5.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "2.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency Percentiles (p50 / p90 / p95)",
      "description": "Request duration percentiles from http_request_duration_seconds_bucket. Red dashed line marks the 80ms intentional slow-request warning threshold from test.ts.",
      "datasource": "Mimir",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Mimir",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": "Mimir",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "datasource": "Mimir",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.08 }
            ]
          }
        },
        "overrides": []
      }
    },

    { "id": 8, "type": "row", "title": "Log Stream & Trace Ingestion", "collapsed": false, "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }, "panels": [] },

    {
      "id": 9,
      "type": "logs",
      "title": "Live Application Logs",
      "description": "Live log stream for smoke-test-service. Grafana auto-highlights WARN/ERROR lines by detected log level.",
      "datasource": "Loki",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Loki",
          "expr": "{service_name=\"smoke-test-service\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },

    {
      "id": 10,
      "type": "table",
      "title": "Recent Traces (smoke-test-service)",
      "description": "Recent traces for smoke-test-service - expand to see the nested db-query and background-event-notification child spans.",
      "datasource": "Tempo",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": "Tempo",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"smoke-test-service\" }",
          "tableType": "traces",
          "limit": 20
        }
      ]
    }
  ]
}
