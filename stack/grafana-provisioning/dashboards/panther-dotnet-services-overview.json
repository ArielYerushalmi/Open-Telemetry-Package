{
  "title": "Panther .NET Services - Overview",
  "description": "Multi-service view across every .NET service using the Panther.OpenTelemetry library. Scoped automatically via .NET-only metric names (http_server_request_duration_*, process_runtime_dotnet_gc_*), which Node services never emit - no per-service hardcoding needed. Use the '.NET Services' variable to narrow to specific services; defaults to all of them together, mirroring system-overview.json's all-services approach.",
  "uid": "panther-dotnet-services-overview",
  "tags": ["dotnet", "panther-opentelemetry", "opentelemetry", "mimir", "loki", "tempo"],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "dotnet_services",
        "type": "query",
        "label": ".NET Services",
        "description": "Auto-discovered from services emitting process_runtime_dotnet_gc_collections_count (only .NET services using Panther.OpenTelemetry do). Multi-select to compare a subset; defaults to All.",
        "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
        "query": "label_values(process_runtime_dotnet_gc_collections_count, job)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "hide": 0
      },
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID",
        "description": "Paste a Trace ID from the table below to render its full span waterfall.",
        "query": "",
        "current": { "value": "", "text": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": ".NET Services KPIs", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },

    {
      "id": 2,
      "type": "stat",
      "title": ".NET Services Reporting",
      "description": "Count of distinct .NET services (matching the selection above) that have reported telemetry in the selected range.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "count(count by (job) (process_runtime_dotnet_gc_collections_count{job=~\"${dotnet_services:regex}\"}))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Total HTTP Requests (.NET, selected services)",
      "description": "Total inbound HTTP requests across the selected .NET services over the selected range (OpenTelemetry.Instrumentation.AspNetCore).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum(increase(http_server_request_duration_count{job=~\"${dotnet_services:regex}\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate % (.NET, selected services)",
      "description": "Share of requests with a 5xx status code vs total, across the selected .NET services.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "100 * sum(increase(http_server_request_duration_count{job=~\"${dotnet_services:regex}\", http_response_status_code=~\"5..\"}[$__range])) / sum(increase(http_server_request_duration_count{job=~\"${dotnet_services:regex}\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "95th Percentile Latency (.NET, selected services)",
      "description": "p95 HTTP server request duration across the selected .NET services over the last 5m.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_bucket{job=~\"${dotnet_services:regex}\"}[5m])))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      }
    },

    { "id": 6, "type": "row", "title": "Per-Service Performance", "collapsed": false, "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 } },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Rate by Service",
      "description": "Requests per second, split by .NET service (job).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum by (job) (rate(http_server_request_duration_count{job=~\"${dotnet_services:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 Latency by Service",
      "description": "95th percentile HTTP server request duration, split by .NET service (job).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_bucket{job=~\"${dotnet_services:regex}\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Error Rate % by Service",
      "description": "Share of requests returning 5xx, split by .NET service (job).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "100 * sum by (job) (rate(http_server_request_duration_count{job=~\"${dotnet_services:regex}\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (job) (rate(http_server_request_duration_count{job=~\"${dotnet_services:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Throughput by Status Code (all selected services)",
      "description": "Requests per second across the selected .NET services, split by HTTP status code.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_count{job=~\"${dotnet_services:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "500" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "200" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },

    { "id": 11, "type": "row", "title": ".NET Runtime Health", "collapsed": false, "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 } },

    {
      "id": 12,
      "type": "timeseries",
      "title": "GC Collections by Service & Generation",
      "description": "process.runtime.dotnet.gc.collections.count from OpenTelemetry.Instrumentation.Runtime, split by service and generation.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum by (job, generation) (process_runtime_dotnet_gc_collections_count{job=~\"${dotnet_services:regex}\"})",
          "legendFormat": "{{job}} - gen {{generation}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "GC Heap Size by Service",
      "description": "process.runtime.dotnet.gc.objects.size - total bytes on the managed heap, split by service.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "process_runtime_dotnet_gc_objects_size{job=~\"${dotnet_services:regex}\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    { "id": 14, "type": "row", "title": "Logs Across .NET Services", "collapsed": false, "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 } },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Log Volume by Service and Level",
      "description": "Log lines per selected .NET service per level, from Loki.",
      "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
          "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\"${dotnet_services:regex}\"}[$__interval]))",
          "legendFormat": "{{service_name}} ({{detected_level}})"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(ERROR\\)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(WARN\\)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      }
    },

    {
      "id": 16,
      "type": "logs",
      "title": "Live Logs (.NET services)",
      "description": "Live combined log stream across the selected .NET services, shipped via Panther.OpenTelemetry's AddPantherOpenTelemetry() -> ILogger -> OTLP -> Loki.",
      "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
          "expr": "{service_name=~\"${dotnet_services:regex}\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },

    { "id": 17, "type": "row", "title": "Traces Across .NET Services", "collapsed": false, "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 } },

    {
      "id": 18,
      "type": "table",
      "title": "Recent Traces (.NET services) - click a Trace ID to open it, or copy it into the Trace ID box above",
      "description": "Most recent traces across the selected .NET services. Clicking a Trace ID opens the full waterfall in Explore; copying it into the 'Trace ID' dashboard variable renders the waterfall inline below.",
      "datasource": {"type": "tempo", "uid": "P214B5B846CF3925F"},
      "gridPos": { "x": 0, "y": 49, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "tempo", "uid": "P214B5B846CF3925F"},
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${dotnet_services:regex}\" }",
          "tableType": "traces",
          "limit": 30
        }
      ]
    },

    {
      "id": 19,
      "type": "traces",
      "title": "Trace Detail: $traceId",
      "description": "Full span waterfall for the Trace ID entered in the 'Trace ID' variable above.",
      "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
      "timeFrom": "24h",
      "gridPos": { "x": 0, "y": 58, "w": 24, "h": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
          "queryType": "traceql",
          "query": "${traceId}"
        }
      ],
      "options": {
        "showSpanFilters": true
      }
    }
  ]
}
