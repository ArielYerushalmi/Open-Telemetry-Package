{
  "title": "Panther System - Full Observability",
  "description": "System-wide view across all instrumented Panther microservices (AuthService, RoomManager, DeviceManager, ImportExportService, WebSocketGateway) - service graph, per-service KPIs, logs, and traces.",
  "uid": "panther-system-overview",
  "tags": ["panther", "system", "opentelemetry", "service-graph"],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID",
        "description": "Paste a Trace ID from the table below to render its full span waterfall.",
        "query": "",
        "current": { "value": "", "text": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "System KPIs", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": [] },

    {
      "id": 2,
      "type": "stat",
      "title": "Services Reporting",
      "description": "Count of distinct instrumented services that have reported telemetry in the selected range.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "count(count by (job) (up{job!=\"\"} or nodejs_eventloop_delay_mean or http_server_duration_count))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Total HTTP Requests (system-wide)",
      "description": "Total inbound HTTP requests across every instrumented service over the selected range.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum(increase(http_server_duration_count[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "System-Wide Error Rate",
      "description": "Share of requests with a 4xx/5xx status code vs total, across every service.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "100 * sum(increase(http_server_duration_count{http_status_code=~\"4..|5..\"}[$__range])) / sum(increase(http_server_duration_count[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "95th Percentile Latency (system-wide)",
      "description": "p95 HTTP server request duration across all services over the last 5m.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_bucket[5m])))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      }
    },

    { "id": 6, "type": "row", "title": "Service Dependency Graph", "collapsed": false, "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 } },

    {
      "id": 7,
      "type": "table",
      "title": "Services Table (rate / error rate / duration)",
      "description": "Per-service request rate, error rate, and p90 duration, computed by Tempo's metrics-generator from real traces.",
      "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
          "queryType": "serviceMap"
        }
      ]
    },

    {
      "id": 8,
      "type": "nodeGraph",
      "title": "Full System Node Graph",
      "description": "Live service map across the entire Panther system, computed by Tempo's metrics-generator (service-graphs processor) from real traces. Every node and edge here reflects an actual observed call.",
      "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
          "queryType": "serviceMap"
        }
      ]
    },

    { "id": 9, "type": "row", "title": "Per-Service Performance", "collapsed": false, "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 } },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Rate by Service",
      "description": "Requests per second, split by service (job).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum by (job) (rate(http_server_duration_count[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 Latency by Service",
      "description": "95th percentile HTTP server request duration, split by service (job).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_duration_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Error Rate by Service",
      "description": "Share of requests returning 4xx/5xx, split by service (job).",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "100 * sum by (job) (rate(http_server_duration_count{http_status_code=~\"4..|5..\"}[$__rate_interval])) / sum by (job) (rate(http_server_duration_count[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "Event Loop Delay by Service",
      "description": "Node.js event loop delay (mean), split by service - a rising trend indicates a process falling behind.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "nodejs_eventloop_delay_mean",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "Process CPU Utilization by Service",
      "description": "Node.js process CPU utilization (user + system time), split by service. From @opentelemetry/host-metrics.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "sum by (job) (process_cpu_utilization)",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    {
      "id": 23,
      "type": "timeseries",
      "title": "Process Memory (RSS) by Service",
      "description": "Node.js process resident memory usage, split by service. From @opentelemetry/host-metrics.",
      "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
      "gridPos": { "x": 12, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "PAE45454D0EDB9216"},
          "expr": "process_memory_usage",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },

    { "id": 14, "type": "row", "title": "Logs Across the System", "collapsed": false, "gridPos": { "x": 0, "y": 54, "w": 24, "h": 1 } },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Log Volume by Service and Level",
      "description": "Log lines per service per level, from Loki.",
      "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
      "gridPos": { "x": 0, "y": 55, "w": 24, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
          "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\".+\"}[$__interval]))",
          "legendFormat": "{{service_name}} ({{detected_level}})"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(ERROR\\)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(FATAL\\)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(WARN\\)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      }
    },

    {
      "id": 16,
      "type": "logs",
      "title": "Live Logs (all services)",
      "description": "Live combined log stream across every instrumented Panther service.",
      "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
      "gridPos": { "x": 0, "y": 62, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
          "expr": "{service_name=~\".+\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },

    { "id": 17, "type": "row", "title": "Traces Across the System", "collapsed": false, "gridPos": { "x": 0, "y": 71, "w": 24, "h": 1 } },

    {
      "id": 18,
      "type": "table",
      "title": "Recent Traces (all services) - click a Trace ID to open it, or copy it into the Trace ID box above",
      "description": "Most recent traces across every instrumented service. Clicking a Trace ID opens the full waterfall in Explore; copying it into the 'Trace ID' dashboard variable renders the waterfall inline below.",
      "datasource": {"type": "tempo", "uid": "P214B5B846CF3925F"},
      "gridPos": { "x": 0, "y": 72, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "tempo", "uid": "P214B5B846CF3925F"},
          "queryType": "traceql",
          "query": "{}",
          "tableType": "traces",
          "limit": 30
        }
      ]
    },

    {
      "id": 19,
      "type": "traces",
      "title": "Trace Detail: $traceId",
      "description": "Full span waterfall for the Trace ID entered in the 'Trace ID' variable above.",
      "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
      "timeFrom": "24h",
      "gridPos": { "x": 0, "y": 81, "w": 24, "h": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "P214B5B846CF3925F" },
          "queryType": "traceql",
          "query": "${traceId}"
        }
      ],
      "options": {
        "showSpanFilters": true
      }
    },

    { "id": 20, "type": "row", "title": "Panther Alerts", "collapsed": false, "gridPos": { "x": 0, "y": 97, "w": 24, "h": 1 } },

    {
      "id": 21,
      "type": "alertlist",
      "title": "Panther Alert Rules",
      "description": "Live state of all provisioned Panther alert rules (High Error Rate, High p95 Latency, High Error Log Volume, Services Missing). Rows turn yellow/red as rules move Pending/Alerting.",
      "gridPos": { "x": 0, "y": 98, "w": 24, "h": 9 },
      "options": {
        "maxItems": 20,
        "sortOrder": 3,
        "dashboardAlerts": false,
        "alertName": "",
        "groupMode": "default",
        "groupBy": [],
        "stateFilter": { "firing": true, "pending": true, "noData": true, "normal": true, "error": true },
        "viewMode": "list"
      }
    }
  ]
}
